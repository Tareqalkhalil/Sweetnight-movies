# Local PostgreSQL connection for development
DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5432/sweet_night?schema=public"

# Optional Supabase PostgreSQL connection
DATABASE_URL_SUPABASE="postgresql://your-supabase-user:your-supabase-password@your-host.supabase.co:5432/postgres?schema=public"

# Prisma schema still uses DATABASE_URL for CLI operations such as migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sweet_night?schema=public"
USE_SUPABASE_DB=false

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret

# Admin
NEXT_PUBLIC_ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PASSWORD=replace-with-a-strong-password

# Supabase frontend
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
